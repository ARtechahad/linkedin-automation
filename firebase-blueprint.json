{
  "entities": {
    "User": {
      "fields": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      }
    },
    "Project": {
      "fields": {
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "channel": { "type": "string" },
        "websiteType": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "estimatedPrice": { "type": "number" },
        "finalPrice": { "type": "number" },
        "advancePaid": { "type": "boolean" },
        "advanceAmount": { "type": "number" },
        "balancePaid": { "type": "boolean" },
        "balanceAmount": { "type": "number" },
        "domainTransferred": { "type": "boolean" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "UserData": {
      "fields": {
        "userId": { "type": "string" },
        "theme": { "type": "string" },
        "language": { "type": "string" },
        "currency": { "type": "string" },
        "scaleMode": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "ChatMessage": {
      "fields": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "channel": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n    \n    match /users/{userId} {\n      allow read: if isSignedIn();\n      allow write: if isSignedIn() && request.auth.uid == userId;\n    }\n    \n    match /projects/{projectId} {\n      allow read, write: if isSignedIn();\n    }\n    \n    match /userData/{userId} {\n      allow read, write: if isSignedIn() && request.auth.uid == userId;\n    }\n    \n    match /chatMessages/{messageId} {\n      allow read, create: if isSignedIn();\n      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.senderId;\n    }\n  }\n}"
}
